# ============================================
# StorShoes Environment Variables
# ============================================

# Database
DATABASE_URL="postgresql://storshoes:storshoes_pass@localhost:5432/storshoes_db?schema=public"

# Backend API
API_PORT=3001
NODE_ENV="development"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="7d"

# Image storage (recommended in production)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional local uploads path for development fallback
UPLOADS_PATH=""

# Frontend URLs
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
VITE_API_URL="http://localhost:3001/api"

# Admin defaults
ADMIN_DEFAULT_EMAIL="admin@storshoes.com"
ADMIN_DEFAULT_PASSWORD="Admin@123456"
