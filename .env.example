# ============================================
# StorShoes Environment Variables
# ============================================

# Database
DATABASE_URL="postgresql://storshoes:storshoes_pass@localhost:5432/storshoes_db?schema=public"

# Backend API
API_PORT=3001
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="7d"

# Frontend URLs
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
VITE_API_URL="http://localhost:3001/api"

# Admin defaults
ADMIN_DEFAULT_EMAIL="admin@storshoes.com"
ADMIN_DEFAULT_PASSWORD="Admin@123456"
